{
    "name": "seek",
    "version": "1.11.0",
    "description": "Obsidian plugin for on-device hybrid semantic and lexical vault search.",
    "main": "main.js",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "node esbuild.config.mjs production",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:ci:index-store": "vitest run --config ci/vitest.index-store.config.mts",
        "test:ci:search": "vitest run --config ci/vitest.search.config.mts",
        "test:ci:cli-ux": "vitest run --config ci/vitest.cli-ux.config.mts",
        "test:ci:platform": "vitest run --config ci/vitest.platform.config.mts",
        "test:functional-fixtures": "vitest run --config ci/vitest.functional-fixtures.config.mts",
        "test:ci:all": "npm run test:ci:index-store && npm run test:ci:search && npm run test:ci:cli-ux && npm run test:ci:platform && npm run test:functional-fixtures",
        "test:e2e-triage": "vitest run scripts/ci/e2e-triage.test.ts",
        "version": "node version-bump.mjs && git add manifest.json versions.json"
    },
    "keywords": [
        "obsidian",
        "semantic-search",
        "embeddings",
        "transformers.js"
    ],
    "author": "Ryan Manor",
    "license": "MIT",
    "devDependencies": {
        "@types/node": "^22.0.0",
        "esbuild": "^0.24.0",
        "fake-indexeddb": "^6.2.5",
        "obsidian": "^1.7.2",
        "typescript": "^5.6.0",
        "vitest": "^2.1.0",
        "yaml": "^2.9.0"
    },
    "dependencies": {
        "minisearch": "^7.2.0"
    }
}
